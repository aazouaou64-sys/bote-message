# Copy this file to .env (or put these values in your hosting's "Environment variables").
# Never share these values with anyone.

# Claude (https://platform.claude.com -> API keys)
ANTHROPIC_API_KEY=

# Meta app (developers.facebook.com -> your app)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# Any word you choose; type the same word in the Webhooks screen.
META_VERIFY_TOKEN=

# WhatsApp: where confirmed orders are sent (see GUIDE.md, step 7)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The shop's WhatsApp number that receives orders (0778396959)
ORDERS_WHATSAPP_TO=213778396959
# WHATSAPP_TEMPLATE=new_order
# WHATSAPP_TEMPLATE_LANG=ar

# true = test mode (replies only written in logs). Set to false to really answer customers.
DRY_RUN=true

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# HUMAN_PAUSE_HOURS=12
# PORT=3000
